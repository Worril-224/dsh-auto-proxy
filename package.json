{
  "name": "@local/dsh-auto-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Routes the agent's GitHub, Hugging Face, npm and PyPI traffic through the local proxy this machine already runs.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
